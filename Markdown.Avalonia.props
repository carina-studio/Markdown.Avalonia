<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <PackageTargetFrameworks>net8.0;net9.0</PackageTargetFrameworks>
    <DemoAppTargetFrameworks>net10.0</DemoAppTargetFrameworks>
    <TestTargetFrameworks>net9.0</TestTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IS_WHISTYUN_PC)' == 'Y' ">
    <TestTargetFrameworks>netcoreapp3.1;net5;net6;net7</TestTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>12.0.2</AvaloniaVersion>
    <DemoAvaloniaVersion>12.1.0</DemoAvaloniaVersion>
    <EnableAvaloniaEdit>enabled</EnableAvaloniaEdit>
    <AvaloniaEditVersion>12.0.0</AvaloniaEditVersion>
    <AvaloniaSvgVersion>12.0.0</AvaloniaSvgVersion>
    <ReactiveUIAvaloniaVersion>12.0.3</ReactiveUIAvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(AVA_VER)' != '' ">
    <TestAvaloniaVersion>$(AVA_VER)</TestAvaloniaVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(AVA_VER)' == '' ">
    <TestAvaloniaVersion>$(AvaloniaVersion)</TestAvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageVersion>12.0.0.700</PackageVersion>
  </PropertyGroup>

</Project>


